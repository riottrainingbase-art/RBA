{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node node_modules/next/dist/bin/next build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview-rba": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
